rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /sellers/{sellerId} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == sellerId;
      allow update: if isOwner(sellerId) || isOwner(resource.data.ownerId) || isOwner(resource.data.uid);
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid
      );
      allow create: if isSignedIn()
        && request.resource.data.buyerId == request.auth.uid
        && !request.resource.data.keys().hasAny(['doorCode']);
      allow update: if isSignedIn()
        && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'doorCodeHash', 'doorCode', 'escrowStatus', 'payoutStatus',
          'sellerEarnings', 'commission', 'transferRef'
        ])
        && request.resource.data.status != 'completed';
      allow delete: if false;
    }

    match /orderSecrets/{orderId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /chats/{chatId} {
      function isChatParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participants;
      }
      allow read: if isChatParticipant();
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if isChatParticipant();
        allow create, update, delete: if false;
      }
    }
  }
}
