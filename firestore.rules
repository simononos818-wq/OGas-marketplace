rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'simononos818@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }
    function orderBuyer(data) {
      return data.buyerId != null ? data.buyerId : data.userId;
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow delete: if false;
    }
    match /sellers/{sellerId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == sellerId
        && request.resource.data.verified == false;
      allow update: if isAdmin() || (
        request.auth != null && request.auth.uid == sellerId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['businessName','ownerName','address','state','location',
                    'cylinderSizes','prices','isActive','deliveryFee','updatedAt',
                    'name','phone','email','city','pricePerKg','availableSizes'])
      );
      allow delete: if false;
    }
    match /orders/{orderId} {
      allow read: if request.auth != null && (
        orderBuyer(resource.data) == request.auth.uid ||
        resource.data.sellerId == request.auth.uid || isAdmin()
      );
      allow create: if request.auth != null
        && orderBuyer(request.resource.data) == request.auth.uid
        && request.resource.data.paymentStatus == 'pending';
      allow update: if isAdmin() || (
        request.auth != null && (
          (resource.data.sellerId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])) ||
          (orderBuyer(resource.data) == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating','review','updatedAt','paymentStatus','paystackRef','status']))
        )
      );
      allow delete: if false;
    }
    match /orderSecrets/{secretId} { allow read, write: if isAdmin(); }
    match /chats/{chatId} { allow read, write: if isAdmin(); }
    match /chats/{chatId}/messages/{messageId} { allow read, write: if isAdmin(); }
  }
}
