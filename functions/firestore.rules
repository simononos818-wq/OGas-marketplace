rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Admin access comes only from a verified, fixed admin identity or a
    // trusted Firebase custom claim. Never trust a client-editable user profile.
    function isAdmin() {
      return signedIn() && (
        request.auth.token.get('admin', false) == true ||
        (
          request.auth.token.get('email', '') == 'simononos818@gmail.com' &&
          request.auth.token.get('email_verified', false) == true
        )
      );
    }

    function isOrderParticipant(order) {
      return signedIn() && (
        order.buyerId == request.auth.uid ||
        order.sellerId == request.auth.uid ||
        isAdmin()
      );
    }

    function isChatParticipant(chat) {
      return signedIn() && (
        chat.buyerId == request.auth.uid ||
        chat.sellerId == request.auth.uid ||
        isAdmin()
      );
    }

    function hasProtectedUserFields(data) {
      return data.keys().hasAny(['role', 'admin', 'isAdmin', 'permissions']);
    }

    // USERS: a user can edit their own ordinary profile fields, never roles.
    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == userId
        && !hasProtectedUserFields(request.resource.data);
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'admin', 'isAdmin', 'permissions'])
      );
      allow delete: if false;
    }

    // SELLERS: public store discovery remains available. Payout/bank data must
    // live in sellerPrivate/{sellerId}, which has no client access below.
    match /sellers/{sellerId} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == sellerId
        && request.resource.data.get('isApproved', false) == false
        && request.resource.data.get('isVerified', false) == false
        && request.resource.data.get('verified', false) == false
        && request.resource.data.get('status', 'pending') == 'pending'
        && request.resource.data.get('sellerStatus', 'pending') == 'pending'
        && !request.resource.data.keys().hasAny([
          'accountNumber', 'bankCode', 'bankName', 'accountName',
          'bankResolved', 'bankUpdatedAt', 'paystackRecipientCode', 'bankLocked'
        ]);
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == sellerId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isApproved', 'verified', 'isVerified', 'status', 'sellerStatus',
          'level', 'gates', 'approvalNotes', 'completedOrders',
          'accountNumber', 'bankCode', 'bankName', 'accountName',
          'bankResolved', 'bankUpdatedAt', 'paystackRecipientCode', 'bankLocked'
        ])
      );
      allow delete: if false;
    }

    // Server APIs (Admin SDK) own all order creation and state/payment changes.
    // Clients may only read orders in which they are a buyer or seller.
    match /orders/{orderId} {
      allow get, list: if isOrderParticipant(resource.data);
      allow create, update, delete: if false;
    }

    // Door codes are returned to the buyer by the authenticated order API.
    // No client can write or enumerate these secret documents.
    match /orderSecrets/{secretId} {
      allow get: if signedIn() && resource.data.buyerId == request.auth.uid;
      allow list, create, update, delete: if false;
    }

    // Chat content is readable only by the order's two participants.
    // Message creation, edits, and read-state changes go through server APIs.
    match /chats/{chatId} {
      allow get, list: if isChatParticipant(resource.data);
      allow create, update, delete: if false;

      match /messages/{messageId} {
        function parentChat() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }
        allow get, list: if isChatParticipant(parentChat());
        allow create, update, delete: if false;
      }
    }

    match /sellerPrivate/{sellerId} {
      allow read, write: if false;
    }

    // GAS POINTS LEDGER — owner reads only; all writes are server-side.
    match /pointsTransactions/{txId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /notifications/{notifId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /payouts/{payoutId} {
      allow read: if signedIn() && (
        isAdmin() || request.auth.uid == resource.data.sellerId
      );
      allow write: if false;
    }

    // Default deny for every collection not explicitly listed above.
  }
}
